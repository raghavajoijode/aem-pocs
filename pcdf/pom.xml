<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aem.poc</groupId>
        <artifactId>aem-poc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>aem-poc.pcdf</artifactId>
    <packaging>content-package</packaging>
    <name>AEM POCs - PCDF container</name>
    <description>Shareable PCDF zip (core.pcdf + ui.apps.pcdf + ui.content.pcdf + ui.config.pcdf only)</description>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <group>com.aem.poc.pcdf</group>
                    <name>com.aem.poc.pcdf</name>
                    <packageType>mixed</packageType>
                    <skipSubPackageValidation>true</skipSubPackageValidation>
                    <embeddeds>
                        <embedded>
                            <groupId>com.aem.poc</groupId>
                            <artifactId>aem-poc.core.pcdf</artifactId>
                            <target>/apps/aem-pocs-pcdf-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.aem.poc</groupId>
                            <artifactId>aem-poc.ui.apps.pcdf</artifactId>
                            <type>zip</type>
                            <target>/apps/aem-pocs-pcdf-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.aem.poc</groupId>
                            <artifactId>aem-poc.ui.config.pcdf</artifactId>
                            <type>zip</type>
                            <target>/apps/aem-pocs-pcdf-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.aem.poc</groupId>
                            <artifactId>aem-poc.ui.content.pcdf</artifactId>
                            <type>zip</type>
                            <target>/apps/aem-pocs-pcdf-packages/content/install</target>
                        </embedded>
                    </embeddeds>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.day.jcr.vault</groupId>
                <artifactId>content-package-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>com.aem.poc</groupId>
            <artifactId>aem-poc.core.pcdf</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aem.poc</groupId>
            <artifactId>aem-poc.ui.apps.pcdf</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.aem.poc</groupId>
            <artifactId>aem-poc.ui.config.pcdf</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.aem.poc</groupId>
            <artifactId>aem-poc.ui.content.pcdf</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>autoInstallPcdf</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.day.jcr.vault</groupId>
                        <artifactId>content-package-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-pcdf-author</id>
                                <goals>
                                    <goal>install</goal>
                                </goals>
                                <configuration>
                                    <targetURL>http://${aem.host}:${aem.port}/crx/packmgr/service.jsp</targetURL>
                                    <failOnError>true</failOnError>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>autoInstallPcdfPublish</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.day.jcr.vault</groupId>
                        <artifactId>content-package-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-pcdf-publish</id>
                                <goals>
                                    <goal>install</goal>
                                </goals>
                                <configuration>
                                    <targetURL>http://${aem.publish.host}:${aem.publish.port}/crx/packmgr/service.jsp</targetURL>
                                    <failOnError>true</failOnError>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
